# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=           # base64 encoded PEM
GITHUB_WEBHOOK_SECRET=

# AI provider — the model strings below are the only place the provider is named.
# Whatever you set here is what gets recorded on each ai_usage row and priced on
# the admin finance page (/admin/finance → "Model rates").
# The old GEMINI_* names are still read as a fallback, with a deprecation warning.
AI_API_KEY=
AI_SCAN_MODEL=gemini-3.5-flash               # PR diff scans — highest volume, drives finding quality
AI_SWEEP_MODEL=gemini-3.5-flash              # security sweeps — higher quality adversarial analysis
AI_DISCOVERY_MODEL=gemini-2.5-flash          # repo classification + auth-file extraction — bounded JSON task, cheap tier is enough
AI_VERIFIER_MODEL=                           # verification (judge) pass model — optional, defaults to AI_SCAN_MODEL
VERIFY_FINDINGS=                             # set to "off" to disable the verification pass (default: on)

AI_BASE_URL=                                
AI_STRUCTURED_MODE=                          # json_schema | tool_strict | json_object — defaults to json_object, see below
AI_PROVIDER_ORDER=                           # aggregators only: pinned endpoint slugs, preferred first
AI_ALLOW_FALLBACKS=                          # aggregators only: "off" to fail rather than route outside the pin
#
# Single-model endpoint:
#   AI_BASE_URL=https://host.example/v1
#   AI_SCAN_MODEL=<model id that host publishes>
#   Set every model var above to an id that host serves — AI_BASE_URL selects one
#   provider for the whole process, so a leftover id from another vendor fails
#   per call rather than at boot. Delete the legacy GEMINI_* names when you
#   switch: they are still read as a fallback and will silently win.
#
# Aggregator, pinned to named endpoints:
#   AI_BASE_URL=https://aggregator.example/api/v1
#   AI_SCAN_MODEL=<vendor>/<model>
#   AI_PROVIDER_ORDER=<slug>,<slug>
#   Pinning also sets require_parameters (never route somewhere that would drop
#   the schema) and data_collection=deny (customer source code).
#
# On AI_STRUCTURED_MODE: json_object is the default because it is the only mode
# every OpenAI-compatible host implements, and guessing high fails every scan
# rather than degrading. Raise it to json_schema once /admin/eval shows the
# endpoint actually enforces the schema. Some hosts serve strict tool calling
# from a separate base path — point AI_BASE_URL at that path if you use
# tool_strict. Most hosts do not cache implicitly, so a cache_control breakpoint
# is always sent; hosts that cache on their own ignore it.
DISCOVERY_CACHE_TTL_DAYS=90                  # re-run security-context discovery after this many days, even if no auth file changed (optional, defaults to 90)

# Database
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Notifications
RESEND_API_KEY=                   # Resend email alerts (optional)

# Queue (Redis for Bull — optional, falls back to inline processing)
REDIS_URL=                        # e.g. redis://localhost:6379
REDIS_TLS_REJECT_UNAUTHORIZED=    # set to "false" ONLY for legacy providers with self-signed certs
# Scans run one at a time by default: each is one long AI call, and running
# several in parallel against one provider account is what caused the timeouts
# this queue is tuned around. Raise it only alongside the AI timeout rate and
# p95 scan duration — and lower SCAN_QUEUE_TIMEOUT_MINUTES to match, since a
# faster-draining queue means a long 'pending' wait is likelier to be a real drop.
SCAN_WORKER_CONCURRENCY=          # scans processed concurrently (default 1)

# Stranded-scan reaper — closes out scans stuck in 'pending' because the queued
# job was never processed (Redis throttled, queue lost on restart, worker killed).
SCAN_REAPER=                      # set to "off" to disable
SCAN_REAPER_INTERVAL_MINUTES=     # how often to sweep (default 5)
# Two clocks, because a job that was never picked up and one whose worker died
# mid-run need different patience. Queue age must clear the worst realistic
# backlog (the worker runs at concurrency 1) or healthy queued scans get reaped;
# run age only has to exceed one attempt, so it can stay tight.
SCAN_QUEUE_TIMEOUT_MINUTES=       # age at which a never-picked-up scan is considered dropped (default 60)
SCAN_STRAND_TIMEOUT_MINUTES=      # runtime after which a picked-up scan is considered dead (default 15)

# Internal API (shared secret between web dashboard and backend)
INTERNAL_API_KEY=                 # generate: openssl rand -hex 32

# App
PORT=3200
NODE_ENV=development # | production
ALLOWED_ORIGINS=http://localhost:3201 # comma-separated in prod, e.g. https://gitsentry.dev

# Email notifications
FROM_EMAIL=                      # e.g. Gitsentry.dev <alerts@gitsentry.dev>
PRODUCT_URL=                     # e.g. https://gitsentry.dev