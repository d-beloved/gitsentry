# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=           # base64 encoded PEM
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GEMINI_API_KEY=
GEMINI_SCAN_MODEL=gemini-2.5-flash           # PR diff scans — fast, cost-effective
GEMINI_SWEEP_MODEL=gemini-3.5-flash          # security sweeps — higher quality adversarial analysis
GEMINI_DISCOVERY_MODEL=gemini-2.5-flash      # repo security context discovery
# ANTHROPIC_API_KEY=    # uncomment if switching to Claude

# Database
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Notifications
RESEND_API_KEY=                   # Resend email alerts (optional)

# Queue (Redis for Bull — optional, falls back to inline processing)
REDIS_URL=                        # e.g. redis://localhost:6379

# Internal API (shared secret between web dashboard and backend)
INTERNAL_API_KEY=                 # generate: openssl rand -hex 32

# App
PORT=3000
NODE_ENV=development # | production
ALLOWED_ORIGINS=http://localhost:3001 # comma-separated in prod, e.g. https://gitsentry.dev

# Email notifications
FROM_EMAIL=                      # e.g. Gitsentry.dev <alerts@gitsentry.dev>
PRODUCT_URL=                     # e.g. https://gitsentry.dev