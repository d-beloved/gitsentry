# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=           # base64 encoded PEM
GITHUB_WEBHOOK_SECRET=

# AI: one block per provider. Fill a provider's API key to enable it; /admin/settings
# switches between enabled ones (needs migration 009). Vars never fall back across providers.
AI_PROVIDER=                                 # boot default: anthropic | gemini | openai_compat (must have a key)
AI_SETTINGS_SYNC=                            # "off" to ignore /admin/settings
VERIFY_FINDINGS=                             # "off" to disable the judge pass
# Each block takes: API_KEY, SCAN_MODEL (PR scans), SWEEP_MODEL (sweeps), DISCOVERY_MODEL
# (classification + auth-file extraction), optional VERIFIER_MODEL (defaults to SCAN_MODEL),
# EXTRA_BODY (JSON merged into every request) and SCAN_/SWEEP_/DISCOVERY_/VERIFY_EXTRA_BODY
# (per role, merged over it), plus SCAN_/DISCOVERY_/VERIFY_TIMEOUT_MS overrides.
# In a shell, single-quote JSON values so the double quotes survive.

# Anthropic — reasoning via {"output_config":{"effort":"low|medium|high"}}
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_SCAN_MODEL=
AI_ANTHROPIC_SWEEP_MODEL=
AI_ANTHROPIC_DISCOVERY_MODEL=
AI_ANTHROPIC_SCAN_EXTRA_BODY=
AI_ANTHROPIC_SWEEP_EXTRA_BODY=
AI_ANTHROPIC_DISCOVERY_EXTRA_BODY=
AI_ANTHROPIC_VERIFY_EXTRA_BODY=
AI_ANTHROPIC_SCAN_TIMEOUT_MS=

# OpenAI-compatible host — reasoning spelling is per host, e.g. {"thinking":{"type":"disabled"}}
AI_OPENAI_COMPAT_API_KEY=
AI_OPENAI_COMPAT_BASE_URL=                   # required
AI_OPENAI_COMPAT_SCAN_MODEL=
AI_OPENAI_COMPAT_SWEEP_MODEL=
AI_OPENAI_COMPAT_DISCOVERY_MODEL=
AI_OPENAI_COMPAT_STRUCTURED_MODE=            # json_schema | tool_strict | json_object (default)
AI_OPENAI_COMPAT_PROVIDER_ORDER=             # aggregators only: pinned endpoint slugs, preferred first
AI_OPENAI_COMPAT_ALLOW_FALLBACKS=            # aggregators only: "off" to fail rather than route outside the pin
AI_OPENAI_COMPAT_EXTRA_BODY=
AI_OPENAI_COMPAT_SWEEP_EXTRA_BODY=
AI_OPENAI_COMPAT_VERIFY_EXTRA_BODY=

# Gemini
AI_GEMINI_API_KEY=
AI_GEMINI_SCAN_MODEL=
AI_GEMINI_SWEEP_MODEL=
AI_GEMINI_DISCOVERY_MODEL=

# Shared per-call budgets (ms), used when a provider sets none. A blown budget fails the scan.
AI_SCAN_TIMEOUT_MS=               # PR scans and sweeps (default 300000)
AI_DISCOVERY_TIMEOUT_MS=          # classification + discovery (default 60000)
AI_VERIFY_TIMEOUT_MS=             # judge pass, fails open (default 120000)
# With AI_PROVIDER unset, unprefixed AI_API_KEY / AI_BASE_URL / AI_*_MODEL still work (legacy).

DISCOVERY_CACHE_TTL_DAYS=90                  # re-run security-context discovery after this many days

# Database
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Notifications
RESEND_API_KEY=                   # Resend email alerts (optional)

# Queue (Redis for Bull — optional, falls back to inline processing)
REDIS_URL=                        # e.g. redis://localhost:6379
REDIS_TLS_REJECT_UNAUTHORIZED=    # set to "false" ONLY for legacy providers with self-signed certs
# Raise only while watching AI timeouts; lower SCAN_QUEUE_TIMEOUT_MINUTES to match.
SCAN_WORKER_CONCURRENCY=          # scans processed concurrently (default 1)

# Stranded-scan reaper: closes out scans whose job was lost or whose worker died.
SCAN_REAPER=                      # set to "off" to disable
SCAN_REAPER_INTERVAL_MINUTES=     # how often to sweep (default 5)
SCAN_QUEUE_TIMEOUT_MINUTES=       # age at which a never-picked-up scan is considered dropped (default 60)
SCAN_STRAND_TIMEOUT_MINUTES=      # runtime after which a picked-up scan is dead (default 15); keep above discovery + scan + verify

# Internal API (shared secret between web dashboard and backend)
INTERNAL_API_KEY=                 # generate: openssl rand -hex 32

# App
PORT=3200
NODE_ENV=development # | production
ALLOWED_ORIGINS=http://localhost:3201 # comma-separated in prod, e.g. https://gitsentry.dev

# Email notifications
FROM_EMAIL=                      # e.g. Gitsentry.dev <alerts@gitsentry.dev>
PRODUCT_URL=                     # e.g. https://gitsentry.dev