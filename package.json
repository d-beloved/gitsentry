{
  "name": "gitsentry",
  "version": "1.0.0",
  "description": "Gitsentry.dev — AI-powered security scanner webhook server",
  "private": true,
  "license": "MIT",
  "main": "apps/backend/src/index.ts",
  "scripts": {
    "dev": "nodemon --exec tsx apps/backend/src/index.ts",
    "start": "node apps/backend/dist/apps/backend/src/index.js",
    "build": "tsc --project apps/backend/tsconfig.json",
    "test": "jest",
    "typecheck": "tsc --project apps/backend/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@octokit/app": "^13.1.8",
    "@supabase/supabase-js": "^2.47.0",
    "bull": "^4.16.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.1",
    "parse-diff": "^0.11.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.41",
    "jest": "^30.4.2",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/backend"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "apps/backend/tsconfig.test.json"
        }
      ]
    }
  },
  "resolutions": {
    "uuid": "^11.0.0",
    "babel-plugin-istanbul": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
